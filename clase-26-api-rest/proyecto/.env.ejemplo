# Copiad este archivo como .env y poned vuestros datos.
# El .env NO se sube a Git: cada ordenador (y el servidor) tiene el suyo.

APP_NOMBRE="Academia Alpe"
APP_DEPURACION=true

DB_HOST=localhost
DB_NOMBRE=academia_crud
DB_USUARIO=root
DB_CLAVE=

# Token secreto para las peticiones de escritura de la API (inventad uno largo)
API_TOKEN=cambiad-este-token-por-uno-largo-y-secreto
# Dirección de la web, para el cliente cURL de herramientas/
API_URL=http://academia-mvc.test
